---
<footer class="bg-surface border-t border-borderLight py-12">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-center gap-6">
            <!-- Logo Footer -->
            <div class="flex items-center gap-2 opacity-80 hover:opacity-100 transition-opacity">
                <div class="w-6 h-6 rounded-md overflow-hidden bg-surface flex-shrink-0">
                    <img src="/favicon.png" alt="FluxWeb Logo" class="w-full h-full object-cover" />
                </div>
                <span class="font-semibold text-lg tracking-tight text-primaryText">FluxWeb</span>
            </div>

            <!-- Links Nav -->
            <nav class="flex flex-wrap justify-center gap-6">
                <a href="#servicios" class="text-sm text-secondaryText hover:text-brand transition-colors">Servicios</a>
                <a href="#beneficios" class="text-sm text-secondaryText hover:text-brand transition-colors">Beneficios</a>
                <a href="#trabajos" class="text-sm text-secondaryText hover:text-brand transition-colors">Casos de Éxito</a>
                <a href="#faq" class="text-sm text-secondaryText hover:text-brand transition-colors">Preguntas</a>
            </nav>

            <!-- Redes / Contacto -->
            <svg width="0" height="0" style="position: absolute;">
              <defs>
                <clipPath id="squircleClip" clipPathUnits="objectBoundingBox">
                  <path d="M 0,0.5 C 0,0 0,0 0.5,0 S 1,0 1,0.5 1,1 0.5,1 0,1 0,0.5"></path>
                </clipPath>
              </defs>
            </svg>
            <div class="relative">
                <div class="absolute inset-0 bg-slate-100/10 dark:bg-black/30 backdrop-blur-xl rounded-2xl border border-slate-200/10 dark:border-white/10 shadow-2xl"></div>
                <div class="relative flex items-end gap-x-2.5 p-2">
                    <!-- Facebook -->
                    <a href="https://www.facebook.com/profile.php?id=61592622020425" target="_blank" rel="noopener noreferrer" class="relative" aria-label="Facebook">
                        <div style="clip-path: url(#squircleClip)" class="w-12 h-12 bg-gradient-to-br from-blue-600 to-blue-800 flex items-center justify-center shadow-lg border border-blue-500/30 cursor-pointer transform transition-all duration-300 ease-out hover:scale-110 hover:-translate-y-1.5 hover:shadow-2xl">
                            <svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6 text-white" xmlns="http://www.w3.org/2000/svg">
                                <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c4.56-.93 8-4.96 8-9.75z"/>
                            </svg>
                        </div>
                    </a>
                    <!-- Instagram -->
                    <a href="https://www.instagram.com/fluxwebx/" target="_blank" rel="noopener noreferrer" class="relative" aria-label="Instagram">
                        <div style="clip-path: url(#squircleClip)" class="w-12 h-12 bg-gradient-to-br from-fuchsia-500 to-purple-600 flex items-center justify-center shadow-lg border border-fuchsia-500/30 cursor-pointer transform transition-all duration-300 ease-out hover:scale-110 hover:-translate-y-1.5 hover:shadow-2xl">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5.5 w-5.5 text-white" xmlns="http://www.w3.org/2000/svg">
                                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                            </svg>
                        </div>
                    </a>
                    <!-- WhatsApp -->
                    <a href="https://wa.me/5492804687998" target="_blank" rel="noopener noreferrer" class="relative" aria-label="WhatsApp">
                        <div style="clip-path: url(#squircleClip)" class="w-12 h-12 bg-gradient-to-br from-emerald-500 to-emerald-700 flex items-center justify-center shadow-lg border border-emerald-500/30 cursor-pointer transform transition-all duration-300 ease-out hover:scale-110 hover:-translate-y-1.5 hover:shadow-2xl">
                            <svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6 text-white" xmlns="http://www.w3.org/2000/svg">
                                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                            </svg>
                        </div>
                    </a>
                    <!-- Email -->
                    <a href="mailto:ditrix102@gmail.com" class="relative" aria-label="Email">
                        <div style="clip-path: url(#squircleClip)" class="w-12 h-12 bg-gradient-to-br from-slate-600 to-slate-800 flex items-center justify-center shadow-lg border border-slate-500/30 cursor-pointer transform transition-all duration-300 ease-out hover:scale-110 hover:-translate-y-1.5 hover:shadow-2xl">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5.5 w-5.5 text-white" xmlns="http://www.w3.org/2000/svg">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                <polyline points="22,6 12,13 2,6"></polyline>
                            </svg>
                        </div>
                    </a>
                </div>
            </div>
        </div>
        
        <div class="mt-8 pt-8 border-t border-borderLight flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="text-xs text-secondaryText">© 2026 FluxWeb. Todos los derechos reservados.</p>
            <div class="flex gap-4">
                <a href="#" class="text-xs text-secondaryText hover:text-primaryText transition-colors">Privacidad</a>
                <a href="#" class="text-xs text-secondaryText hover:text-primaryText transition-colors">Términos</a>
            </div>
        </div>
    </div>
</footer>
