---
---
<header class="fixed top-0 left-0 right-0 z-50 w-full py-3 px-4 flex justify-center transition-all duration-300" id="navbar">
    
    <!-- DESKTOP CAPSULE (Hidden on mobile, visible on lg) -->
    <div id="capsuleAssembly" class="hidden lg:inline-flex items-center justify-center flex-nowrap -space-x-[26px]">
        <!-- 1. EXTREMO IZQUIERDO: Logo y Nombre de Marca -->
        <div id="leftSocket" class="socket-left bg-slate-900 border border-slate-800 h-[52px] pl-6 pr-10 flex items-center z-10 shrink-0 shadow-lg relative">
            <div id="leftContent" class="socket-content flex items-center space-x-3 w-full">
                <div class="w-8 h-8 rounded-full shadow-md shrink-0 overflow-hidden bg-surface">
                    <img src="/favicon.png" alt="FluxWeb Logo" class="w-full h-full object-cover" />
                </div>
                <span class="font-bold text-sm tracking-tight text-white whitespace-nowrap">FluxWeb</span>
            </div>
        </div>

        <!-- 2. CÁPSULA CENTRAL: Menú de navegación -->
        <nav id="centerCapsule" class="relative bg-gradient-to-r from-indigo-600 via-indigo-500 to-violet-600 text-white shadow-xl shadow-indigo-500/20 h-[52px] px-4 rounded-full flex items-center justify-center space-x-1 z-20 border border-indigo-400/40 shrink-0 overflow-hidden">
            <a href="#servicios" onclick="selectNavItem(this, event)" class="nav-item active bg-white/20 text-white font-semibold px-3.5 py-1.5 rounded-full text-xs sm:text-sm transition-all duration-150 whitespace-nowrap">
                Servicios
            </a>
            <a href="#beneficios" onclick="selectNavItem(this, event)" class="nav-item text-indigo-100 hover:bg-white/10 hover:text-white font-medium px-3.5 py-1.5 rounded-full text-xs sm:text-sm transition-all duration-150 whitespace-nowrap">
                Beneficios
            </a>
            <a href="#proceso" onclick="selectNavItem(this, event)" class="nav-item text-indigo-100 hover:bg-white/10 hover:text-white font-medium px-3.5 py-1.5 rounded-full text-xs sm:text-sm transition-all duration-150 whitespace-nowrap">
                Proceso
            </a>
            <a href="#trabajos" onclick="selectNavItem(this, event)" class="nav-item text-indigo-100 hover:bg-white/10 hover:text-white font-medium px-3.5 py-1.5 rounded-full text-xs sm:text-sm transition-all duration-150 whitespace-nowrap">
                Trabajos
            </a>
            <a href="#faq" onclick="selectNavItem(this, event)" class="nav-item text-indigo-100 hover:bg-white/10 hover:text-white font-medium px-3.5 py-1.5 rounded-full text-xs sm:text-sm transition-all duration-150 whitespace-nowrap">
                Preguntas
            </a>
        </nav>

        <!-- 3. EXTREMO DERECHO: Botón de Acción -->
        <div id="rightSocket" class="socket-right bg-slate-900 border border-slate-800 h-[52px] pl-10 pr-6 flex items-center z-10 shrink-0 shadow-lg relative">
            <div id="rightContent" class="socket-content">
                <a href="#contacto" class="px-4 py-1.5 rounded-full bg-indigo-500 hover:bg-indigo-400 text-white text-xs sm:text-sm font-semibold transition-all duration-200 shadow-md shadow-indigo-500/20 flex items-center gap-1.5 whitespace-nowrap active:scale-95">
                    <span>Solicitar presupuesto</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                    </svg>
                </a>
            </div>
        </div>
    </div>

    <!-- MOBILE HEADER (Visible on sm/md, hidden on lg) -->
    <div class="lg:hidden w-full flex justify-between items-center bg-slate-900/95 backdrop-blur-md border border-slate-800 rounded-2xl p-2 px-4 shadow-xl" id="mobileBar">
        <!-- Logo -->
        <a href="#" class="flex items-center space-x-3">
            <div class="w-8 h-8 rounded-full shadow-md overflow-hidden bg-surface">
                <img src="/favicon.png" alt="FluxWeb Logo" class="w-full h-full object-cover" />
            </div>
            <span class="font-bold text-sm tracking-tight text-white">FluxWeb</span>
        </a>

        <!-- CTA Button Mobile -->
        <a href="#contacto" class="px-4 py-2 rounded-full bg-indigo-500 hover:bg-indigo-400 text-white text-xs font-semibold transition-all duration-200 shadow-md shadow-indigo-500/20 flex items-center gap-1.5 whitespace-nowrap active:scale-95">
            <span>Presupuesto</span>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
        </a>

        <!-- Hamburger Button -->
        <button id="mobileMenuToggle" class="text-white p-2 focus:outline-none hover:bg-slate-800 rounded-lg transition-colors" aria-label="Abrir menú">
            <svg class="w-6 h-6" id="menuIconOpen" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
        </button>
    </div>
</header>

<!-- MOBILE MENU OVERLAY (outside header to avoid z-index conflicts) -->
<div id="mobileMenuOverlay" class="fixed inset-0 bg-slate-950/98 backdrop-blur-xl z-[60] flex flex-col items-center justify-center opacity-0 pointer-events-none transition-all duration-300 lg:hidden">
    <!-- Close Button -->
    <button id="mobileMenuClose" class="absolute top-5 right-5 text-white p-3 rounded-full bg-slate-800/80 hover:bg-slate-700 transition-colors" aria-label="Cerrar menú">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
    </button>

    <nav class="flex flex-col space-y-5 text-center">
        <a href="#servicios" class="mobile-nav-item text-2xl text-slate-300 hover:text-white font-medium transition-colors py-2">Servicios</a>
        <a href="#beneficios" class="mobile-nav-item text-2xl text-slate-300 hover:text-white font-medium transition-colors py-2">Beneficios</a>
        <a href="#proceso" class="mobile-nav-item text-2xl text-slate-300 hover:text-white font-medium transition-colors py-2">Proceso</a>
        <a href="#trabajos" class="mobile-nav-item text-2xl text-slate-300 hover:text-white font-medium transition-colors py-2">Trabajos</a>
        <a href="#faq" class="mobile-nav-item text-2xl text-slate-300 hover:text-white font-medium transition-colors py-2">Preguntas</a>
        <div class="pt-4 border-t border-slate-700 mt-2">
            <a href="#contacto" class="mobile-nav-item inline-flex items-center gap-2 text-lg text-white bg-indigo-600 hover:bg-indigo-500 font-semibold px-8 py-3 rounded-full transition-colors">
                Solicitar presupuesto
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
            </a>
        </div>
    </nav>
</div>

<!-- Inline script para el menú móvil: se ejecuta inmediatamente, sin dependencias -->
<script is:inline>
(function() {
    function initMobileMenu() {
        var toggleBtn = document.getElementById('mobileMenuToggle');
        var closeBtn = document.getElementById('mobileMenuClose');
        var overlay = document.getElementById('mobileMenuOverlay');
        var navItems = document.querySelectorAll('.mobile-nav-item');
        
        if (!toggleBtn || !overlay || !closeBtn) return;
        
        function openMenu() {
            overlay.classList.remove('opacity-0', 'pointer-events-none');
            document.body.style.overflow = 'hidden';
        }
        
        function closeMenu() {
            overlay.classList.add('opacity-0', 'pointer-events-none');
            document.body.style.overflow = '';
        }
        
        function scrollToSection(href) {
            if (!href || href === '#') return;
            var target = document.querySelector(href);
            if (target) {
                var rect = target.getBoundingClientRect();
                var scrollTop = window.pageYOffset || document.documentElement.scrollTop;
                var top = rect.top + scrollTop - 80;
                window.scrollTo({ top: top, behavior: 'smooth' });
            }
        }
        
        // Abrir menú
        toggleBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            openMenu();
        });
        
        // Cerrar menú con botón X
        closeBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            closeMenu();
        });
        
        // Click en un link del menú: cierra y hace scroll
        for (var i = 0; i < navItems.length; i++) {
            (function(item) {
                item.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    var href = item.getAttribute('href');
                    closeMenu();
                    // Esperar a que la transición de cierre termine
                    setTimeout(function() {
                        scrollToSection(href);
                    }, 350);
                });
            })(navItems[i]);
        }
    }
    
    // Ejecutar cuando el DOM esté listo
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMobileMenu);
    } else {
        initMobileMenu();
    }
})();
</script>
