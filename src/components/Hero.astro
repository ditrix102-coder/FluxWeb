---
---
<section class="relative min-h-[calc(100svh-5rem)] flex items-center py-10 lg:py-0 overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10 w-full">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-8 items-center">
            
            <!-- Copy principal -->
            <div class="max-w-2xl" data-aos="fade-up" data-aos-duration="800">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-100 text-brand text-xs sm:text-sm font-medium mb-6 sm:mb-8">
                    <span class="relative flex h-2 w-2">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2 w-2 bg-brand"></span>
                    </span>
                    Ayudamos a escalar tu negocio
                </div>
                
                <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-primaryText leading-[1.1] mb-6">
                    Tu negocio necesita <br>
                    <span class="text-brand">más clientes</span>,<br>
                    no más trabajo.
                </h1>
                
                <p class="text-base sm:text-lg lg:text-xl text-secondaryText mb-8 sm:mb-10 leading-relaxed max-w-lg">
                    Creamos páginas web y automatizaciones que trabajan por ti. Conseguimos que vendas más, ahorres horas de tareas repetitivas y te enfoques en lo que realmente importa.
                </p>
                
                <div class="flex flex-col sm:flex-row gap-4">
                    <a href="#contacto" class="flex justify-center items-center gap-2 bg-brand text-white px-6 sm:px-8 py-3.5 sm:py-4 rounded-full text-sm sm:text-base font-medium hover:bg-blue-700 hover:scale-[1.03] smooth-transition shadow-sm">
                        Agendar asesoría gratuita
                        <i data-lucide="arrow-right" class="w-4 h-4"></i>
                    </a>
                    <a href="#servicios" class="flex justify-center items-center gap-2 bg-surface text-primaryText border border-borderLight px-6 sm:px-8 py-3.5 sm:py-4 rounded-full text-sm sm:text-base font-medium hover:bg-gray-50 hover:scale-[1.03] smooth-transition">
                        Ver cómo funciona
                    </a>
                </div>
            </div>

            <!-- Visual / Mockup -->
            <div class="relative lg:ml-auto w-full max-w-lg" data-aos="fade-left" data-aos-duration="1000" data-aos-delay="200">
                <div class="relative rounded-2xl overflow-hidden shadow-premium bg-surface border border-borderLight aspect-square md:aspect-[4/3] lg:aspect-square flex flex-col">
                    <!-- Falso header de navegador -->
                    <div class="h-12 border-b border-borderLight bg-gray-50/50 flex items-center px-4 gap-2">
                        <div class="flex gap-1.5">
                            <div class="w-3 h-3 rounded-full bg-gray-300"></div>
                            <div class="w-3 h-3 rounded-full bg-gray-300"></div>
                            <div class="w-3 h-3 rounded-full bg-gray-300"></div>
                        </div>
                    </div>
                    <!-- Contenido del mockup (Ilustración abstracta de crecimiento y automatización) -->
                    <div class="flex-1 p-8 flex flex-col justify-center relative bg-gradient-to-br from-slate-50 to-blue-50/30">
                        <div class="bg-white p-4 rounded-xl shadow-sm border border-borderLight mb-4 flex items-center gap-4 transform -translate-x-4">
                            <div class="w-10 h-10 rounded-full bg-accent/20 flex items-center justify-center text-accent">
                                <i data-lucide="check" class="w-5 h-5"></i>
                            </div>
                            <div>
                                <div class="text-sm font-semibold">Nueva consulta web</div>
                                <div class="text-xs text-secondaryText">Respondida automáticamente</div>
                            </div>
                        </div>
                        <div class="bg-white p-4 rounded-xl shadow-sm border border-borderLight mb-4 flex items-center gap-4 z-10 translate-x-4">
                            <div class="w-10 h-10 rounded-full bg-brand/20 flex items-center justify-center text-brand">
                                <i data-lucide="calendar" class="w-5 h-5"></i>
                            </div>
                            <div>
                                <div class="text-sm font-semibold">Reunión agendada</div>
                                <div class="text-xs text-secondaryText">Sin intervención manual</div>
                            </div>
                        </div>
                        <div class="bg-white p-4 rounded-xl shadow-sm border border-borderLight flex items-center gap-4 transform -translate-x-2 opacity-80">
                            <div class="w-10 h-10 rounded-full bg-purple-100 flex items-center justify-center text-purple-600">
                                <i data-lucide="trending-up" class="w-5 h-5"></i>
                            </div>
                            <div>
                                <div class="text-sm font-semibold">Venta cerrada</div>
                                <div class="text-xs text-secondaryText">Factura enviada sola</div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Elementos decorativos de fondo -->
                <div class="absolute -top-10 -right-10 w-40 h-40 bg-blue-100 rounded-full blur-3xl opacity-50 -z-10"></div>
                <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-green-100 rounded-full blur-3xl opacity-50 -z-10"></div>
            </div>

        </div>
    </div>
</section>
