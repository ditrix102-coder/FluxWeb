---
---
<section class="relative min-h-[calc(100svh-5rem)] flex items-center py-10 lg:py-0 overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10 w-full">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-8 items-center">
            
            <!-- Copy principal -->
            <div class="max-w-2xl">
                <div id="heroTag" class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-100 text-brand text-xs sm:text-sm font-medium mb-6 sm:mb-8">
                    <span class="relative flex h-2 w-2">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2 w-2 bg-brand"></span>
                    </span>
                    Ayudamos a escalar tu negocio
                </div>
                
                <h1 id="heroTitle" class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-primaryText leading-[1.1] mb-6">
                    Tu negocio necesita <br>
                    <span class="text-brand">más clientes</span>,<br>
                    no más trabajo.
                </h1>
                
                <p id="heroText" class="text-base sm:text-lg lg:text-xl text-secondaryText mb-8 sm:mb-10 leading-relaxed max-w-lg">
                    Creamos páginas web y automatizaciones que trabajan por ti. Conseguimos que vendas más, ahorres horas de tareas repetitivas y te enfoques en lo que realmente importa.
                </p>
                
                <div id="heroButtons" class="flex flex-col sm:flex-row gap-4">
                    <a href="#contacto" id="btn-asesoria" class="flex justify-center gap-2 items-center shadow-xl text-sm sm:text-base font-medium bg-brand text-white border-brand border-2 isolation-auto before:absolute before:w-full before:transition-all before:duration-700 before:hover:w-full before:-left-full before:hover:left-0 before:rounded-full before:bg-blue-700 hover:text-white before:-z-10 before:aspect-square before:hover:scale-150 before:hover:duration-700 relative z-10 px-6 sm:px-8 py-3.5 sm:py-4 overflow-hidden rounded-full group smooth-transition">
                        <span id="btn-asesoria-text" class="relative z-10">Agendar asesoría gratuita</span>
                        <svg class="w-6 h-6 justify-end group-hover:rotate-90 group-hover:bg-white text-white ease-linear duration-300 rounded-full border border-white/30 p-1.5 rotate-45 relative z-10" viewBox="0 0 16 19" xmlns="http://www.w3.org/2000/svg">
                            <path d="M7 18C7 18.5523 7.44772 19 8 19C8.55228 19 9 18.5523 9 18H7ZM8.70711 0.292893C8.31658 -0.0976311 7.68342 -0.0976311 7.29289 0.292893L0.928932 6.65685C0.538408 7.04738 0.538408 7.68054 0.928932 8.07107C1.31946 8.46159 1.95262 8.46159 2.34315 8.07107L8 2.41421L13.6569 8.07107C14.0474 8.46159 14.6805 8.46159 15.0711 8.07107C15.4616 7.68054 15.4616 7.04738 15.0711 6.65685L8.70711 0.292893ZM9 18L9 1H7L7 18H9Z" class="fill-white group-hover:fill-brand"></path>
                        </svg>
                        <span id="btn-asesoria-progress" class="absolute inset-y-0 left-0 bg-white/20 w-0 pointer-events-none z-0"></span>
                    </a>
                    <a href="#servicios" class="bg-surface text-primaryText border border-borderLight border-b-4 font-medium overflow-hidden relative px-6 sm:px-8 py-3.5 sm:py-4 rounded-full text-sm sm:text-base hover:brightness-105 hover:border-t-4 hover:border-b active:opacity-75 outline-none duration-300 group flex justify-center items-center gap-2">
                        <span class="bg-indigo-400 shadow-indigo-400 absolute -top-[150%] left-0 inline-flex w-80 h-[5px] rounded-full opacity-50 group-hover:top-[150%] duration-500 shadow-[0_0_10px_10px_rgba(0,0,0,0.3)]"></span>
                        Ver cómo funciona
                    </a>
                </div>
            </div>

            <!-- Visual / Mockup -->
            <div id="heroMockup" class="relative lg:ml-auto w-full max-w-lg">
                <div class="relative rounded-2xl overflow-hidden shadow-premium bg-surface border border-borderLight aspect-square md:aspect-[4/3] lg:aspect-square flex flex-col">
                    <!-- Falso header de navegador -->
                    <div class="h-12 border-b border-borderLight bg-gray-50/50 dark:bg-slate-800/50 flex items-center px-4 gap-2">
                        <div class="flex gap-1.5">
                            <div class="w-3 h-3 rounded-full bg-gray-300 dark:bg-slate-600"></div>
                            <div class="w-3 h-3 rounded-full bg-gray-300 dark:bg-slate-600"></div>
                            <div class="w-3 h-3 rounded-full bg-gray-300 dark:bg-slate-600"></div>
                        </div>
                    </div>
                    <!-- Contenido del mockup -->
                    <div class="flex-1 p-8 flex flex-col justify-center relative bg-gradient-to-br from-slate-50 to-blue-50/30 dark:from-slate-900 dark:to-slate-800/30">
                        <div id="mockupCard1" class="bg-white dark:bg-slate-800 p-4 rounded-xl shadow-sm border border-borderLight mb-4 flex items-center gap-4">
                            <div class="w-10 h-10 rounded-full bg-accent/20 flex items-center justify-center text-accent">
                                <i data-lucide="check" class="w-5 h-5"></i>
                            </div>
                            <div>
                                <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">Nueva consulta web</div>
                                <div class="text-xs text-slate-500 dark:text-slate-400">Respondida automáticamente</div>
                            </div>
                        </div>
                        <div id="mockupCard2" class="bg-white dark:bg-slate-800 p-4 rounded-xl shadow-sm border border-borderLight mb-4 flex items-center gap-4 z-10">
                            <div class="w-10 h-10 rounded-full bg-brand/20 flex items-center justify-center text-brand">
                                <i data-lucide="calendar" class="w-5 h-5"></i>
                            </div>
                            <div>
                                <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">Reunión agendada</div>
                                <div class="text-xs text-slate-500 dark:text-slate-400">Sin intervención manual</div>
                            </div>
                        </div>
                        <div id="mockupCard3" class="bg-white dark:bg-slate-800 p-4 rounded-xl shadow-sm border border-borderLight flex items-center gap-4">
                            <div class="w-10 h-10 rounded-full bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center text-purple-600 dark:text-purple-400">
                                <i data-lucide="trending-up" class="w-5 h-5"></i>
                            </div>
                            <div>
                                <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">Venta cerrada</div>
                                <div class="text-xs text-slate-500 dark:text-slate-400">Factura enviada sola</div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Elementos decorativos de fondo -->
                <div class="absolute -top-10 -right-10 w-40 h-40 bg-blue-100 rounded-full blur-3xl opacity-50 -z-10"></div>
                <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-green-100 rounded-full blur-3xl opacity-50 -z-10"></div>
            </div>

        </div>
    </div>
</section>
