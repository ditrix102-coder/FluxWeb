        <!-- NUEVA Versión de Celulares (Efecto Card Stacking alternativo) -->
        <div class="block md:hidden">
            <section class="cardStacking">
                <div class="container mx-auto px-4">
                    <div class="row justify-content-center">
                        <div class="col-12">
                            <div class="cardStacking__cards flex flex-col gap-10">  
