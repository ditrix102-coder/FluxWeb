<style>
.container-arch {
  width: 100%;
}

.spacer-arch {
  width: 100%;
  height: 10vh;
}

.arch {
  display: flex;
  gap: 60px;
  justify-content: space-between;
  max-width: 1100px;
  margin-inline: auto;
}

.arch__left {
  display: flex;
  flex-direction: column;
  min-width: 300px;
}

.arch__left .arch__info {
  max-width: 420px;
  height: 100vh;
  display: grid;
  place-items: center;
}

.arch__left .arch__info h4.header {
  font-family: 'Inter', sans-serif;
  font-size: 38px;
  font-weight: 800;
  letter-spacing: -0.84px;
  color: var(--color-primaryText);
}

.arch__left .arch__info p.desc {
  color: var(--color-secondaryText);
  font-size: 17px;
  letter-spacing: -0.3px;
  margin-block: 12px 28px;
  line-height: 1.6;
}

.arch__left .arch__info a.link {
  text-decoration: none;
  padding: 14px 22px;
  color: #121212;
  font-weight: 600;
  border-radius: 40px;
  display: flex;
  gap: 8px;
  width: fit-content;
  align-items: center;
  box-shadow: 0 4px 10px rgba(0,0,0,0.05);
}

#green-arch a.link {
  background-color: #7DD6FF;
}

#blue-arch a.link {
  background-color: #FFA0B0;
}

#pink-arch a.link {
  background-color: #D5FF37;
}

.arch__right {
  flex-shrink: 1;
  height: 100vh;
  width: 100%;
  max-width: 540px;
  position: relative;
  display: flex;
  flex-direction: column;
}

.arch__right .img-wrapper {
  position: absolute;
  top: 50%;
  left: 0;
  transform: translateY(-50%);
  height: 410px;
  width: 100%;
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
}

.arch__right .img-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

/* Estilos específicos para la versión móvil de tarjetas apilables */
.mobile-services-container {
  width: 100%;
}

.mobile-sticky-trigger {
  width: 100%;
}

.mobile-service-card {
  width: 100%;
  height: 100%;
  will-change: transform, opacity;
  box-sizing: border-box;
}

/* NUEVOS ESTILOS CARD STACKING ALTERNATIVO */
.cardStacking {
  overflow: hidden;
  padding: 60px 0;
}

.cardStacking .stackCard {
  border-radius: 30px;
  position: relative;
  width: 100%;
  min-height: 450px;
  padding: 60px 35px;
  transform-origin: 50% -160%;
}

@media (max-width: 900px) {
  .arch {
    gap: 30px;
  }
}
</style>
