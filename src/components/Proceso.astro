---
---
<section id="proceso" class="py-24 bg-background">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-16" data-aos="fade-up">
            <h2 class="text-3xl md:text-4xl font-bold text-primaryText mb-4">Un proceso simple y transparente</h2>
            <p class="text-secondaryText text-lg">Sin dolores de cabeza. Tú nos cuentas qué necesitas, nosotros lo construimos.</p>
        </div>

        <div class="relative max-w-4xl mx-auto">
            <!-- Línea conectora Desktop -->
            <div class="hidden md:block absolute top-1/2 left-0 w-full h-0.5 bg-borderLight -translate-y-1/2 z-0"></div>
            
            <div class="grid grid-cols-1 md:grid-cols-5 gap-8 md:gap-4 relative z-10">
                <!-- Paso 1 -->
                <div class="flex md:flex-col items-center md:text-center gap-4 md:gap-6 group" data-aos="fade-up" data-aos-delay="100">
                    <div class="w-12 h-12 bg-white border-2 border-borderLight rounded-full flex items-center justify-center font-bold text-secondaryText group-hover:border-brand group-hover:text-brand transition-colors shrink-0 shadow-sm relative">
                        1
                        <div class="absolute inset-0 rounded-full bg-brand/10 scale-150 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                    </div>
                    <div>
                        <h4 class="font-bold text-primaryText mb-1">Contacto</h4>
                        <p class="text-xs text-secondaryText">Nos escribes y agendamos.</p>
                    </div>
                </div>
                
                <!-- Paso 2 -->
                <div class="flex md:flex-col items-center md:text-center gap-4 md:gap-6 group" data-aos="fade-up" data-aos-delay="200">
                    <div class="w-12 h-12 bg-white border-2 border-borderLight rounded-full flex items-center justify-center font-bold text-secondaryText group-hover:border-brand group-hover:text-brand transition-colors shrink-0 shadow-sm relative">
                        2
                    </div>
                    <div>
                        <h4 class="font-bold text-primaryText mb-1">Reunión</h4>
                        <p class="text-xs text-secondaryText">Analizamos tu negocio gratis.</p>
                    </div>
                </div>

                <!-- Paso 3 -->
                <div class="flex md:flex-col items-center md:text-center gap-4 md:gap-6 group" data-aos="fade-up" data-aos-delay="300">
                    <div class="w-12 h-12 bg-white border-2 border-brand rounded-full flex items-center justify-center font-bold text-brand bg-blue-50 shrink-0 shadow-sm relative">
                        3
                    </div>
                    <div>
                        <h4 class="font-bold text-primaryText mb-1">Desarrollo</h4>
                        <p class="text-xs text-secondaryText">Construimos tu sistema.</p>
                    </div>
                </div>

                <!-- Paso 4 -->
                <div class="flex md:flex-col items-center md:text-center gap-4 md:gap-6 group" data-aos="fade-up" data-aos-delay="400">
                    <div class="w-12 h-12 bg-white border-2 border-borderLight rounded-full flex items-center justify-center font-bold text-secondaryText group-hover:border-brand group-hover:text-brand transition-colors shrink-0 shadow-sm relative">
                        4
                    </div>
                    <div>
                        <h4 class="font-bold text-primaryText mb-1">Entrega</h4>
                        <p class="text-xs text-secondaryText">Te mostramos cómo usarlo.</p>
                    </div>
                </div>

                <!-- Paso 5 -->
                <div class="flex md:flex-col items-center md:text-center gap-4 md:gap-6 group" data-aos="fade-up" data-aos-delay="500">
                    <div class="w-12 h-12 bg-white border-2 border-borderLight rounded-full flex items-center justify-center font-bold text-secondaryText group-hover:border-brand group-hover:text-brand transition-colors shrink-0 shadow-sm relative">
                        5
                    </div>
                    <div>
                        <h4 class="font-bold text-primaryText mb-1">Soporte</h4>
                        <p class="text-xs text-secondaryText">Estamos contigo si necesitas ayuda.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
